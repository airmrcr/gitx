{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "arrowParens": "always",
  "objectWrap": "preserve",
  "sortImports": false,
  "sortPackageJson": true,
  "insertFinalNewline": true,
  "ignorePatterns": ["dist/**", "coverage/**", "test/__fixtures__/**"]
}
